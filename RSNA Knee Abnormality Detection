    "#v13\n",
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import pydicom\n",
    "import cv2\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision.transforms as transforms\n",
    "import torchvision.models as models\n",
    "from tqdm import tqdm\n",
    "from PIL import Image\n",
    "\n",
    "train_df = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/train.csv')\n",
    "train_series = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series.csv')\n",
    "test_df = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/test.csv')\n",
    "test_series = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/test_series.csv')\n",
    "\n",
    "labels = ['ACL', 'MCL', 'Medial Meniscus', 'Lateral Meniscus', 'Medial OA', 'Lateral OA', 'PF OA', 'Effusion', 'Synovitis', \"Baker's\", 'Contusion', 'Fracture']\n",
    "\n",
    "train_df = train_df.dropna(subset=labels).reset_index(drop=True)\n",
    "\n",
    "class KneeDatasetSmarter(Dataset):\n",
    "    def __init__(self, df, series_df, data_dir, transform=None, is_inference=False):\n",
    "        self.df = df\n",
    "        self.series_df = series_df\n",
    "        self.data_dir = data_dir\n",
    "        self.transform = transform\n",
    "        self.is_inference = is_inference\n",
    "        self.studies = self.df['StudyInstanceUID'].values\n",
    "        \n",
    "    def __len__(self):\n",
    "        return len(self.studies)\n",
    "        \n",
    "    def _process_dcm(self, dcm):\n",
    "        img = dcm.pixel_array\n",
    "        img = img - np.min(img)\n",
    "        if np.max(img) > 0:\n",
    "            img = img / np.max(img)\n",
    "        img = (img * 255).astype(np.uint8)\n",
    "        img = cv2.resize(img, (224, 224))\n",
    "        img = np.stack([img]*3, axis=-1)\n",
    "        return Image.fromarray(img)\n",
    "        \n",
    "    def __getitem__(self, idx):\n",
    "        study_id = self.studies[idx]\n",
    "        study_series = self.series_df[self.series_df['StudyInstanceUID'] == study_id]\n",
    "        \n",
    "        if len(study_series) > 0:\n",
    "            series_id = study_series.iloc[0]['SeriesInstanceUID']\n",
    "            series_dir = os.path.join(self.data_dir, study_id, series_id)\n",
    "            try:\n",
    "                slices = [f for f in os.listdir(series_dir) if f.endswith('.dcm')]\n",
    "                slices.sort()\n",
    "                l = len(slices)\n",
    "                \n",
    "                if self.is_inference:\n",
    "                    # Ensembling 3 slices during validation/test (33%, 50%, 66% depth)\n",
    "                    indices = [max(0, l//3), l//2, min(l-1, 2*l//3)]\n",
    "                    imgs = []\n",
    "                    for s_idx in indices:\n",
    "                        dcm = pydicom.dcmread(os.path.join(series_dir, slices[s_idx]))\n",
    "                        img = self._process_dcm(dcm)\n",
    "                        if self.transform: img = self.transform(img)\n",
    "                        imgs.append(img)\n",
    "                    img_tensor = torch.stack(imgs)\n",
    "                else:\n",
    "                    # Random depth sampling during training to prevent overfitting\n",
    "                    s_idx = np.random.randint(max(0, int(l*0.4)), min(l, int(l*0.6)) + 1)\n",
    "                    dcm = pydicom.dcmread(os.path.join(series_dir, slices[s_idx]))\n",
    "                    img = self._process_dcm(dcm)\n",
    "                    if self.transform: img = self.transform(img)\n",
    "                    img_tensor = img\n",
    "            except:\n",
    "                # Fallback blank images\n",
    "                blank = Image.fromarray(np.zeros((224, 224, 3), dtype=np.uint8))\n",
    "                if self.is_inference:\n",
    "                    img_tensor = torch.stack([self.transform(blank) if self.transform else transforms.ToTensor()(blank) for _ in range(3)])\n",
    "                else:\n",
    "                    img_tensor = self.transform(blank) if self.transform else transforms.ToTensor()(blank)\n",
    "        else:\n",
    "            blank = Image.fromarray(np.zeros((224, 224, 3), dtype=np.uint8))\n",
    "            if self.is_inference:\n",
    "                img_tensor = torch.stack([self.transform(blank) if self.transform else transforms.ToTensor()(blank) for _ in range(3)])\n",
    "            else:\n",
    "                img_tensor = self.transform(blank) if self.transform else transforms.ToTensor()(blank)\n",
    "            \n",
    "        if all(col in self.df.columns for col in labels):\n",
    "            target = self.df.loc[idx, labels].values.astype(np.float32)\n",
    "            return img_tensor, torch.tensor(target)\n",
    "        else:\n",
    "            return img_tensor, study_id\n",
    "\n",
    "# Heavy data augmentation for training\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.RandomRotation(15),\n",
    "    transforms.ColorJitter(brightness=0.2, contrast=0.2),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "test_transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "train_dataset = KneeDatasetSmarter(train_df.iloc[:int(len(train_df)*0.8)].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=train_transform, is_inference=False)\n",
    "val_dataset = KneeDatasetSmarter(train_df.iloc[int(len(train_df)*0.8):].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=test_transform, is_inference=True)\n",
    "test_dataset = KneeDatasetSmarter(test_df, test_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/test_series', transform=test_transform, is_inference=True)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True, num_workers=2)\n",
    "# Reduced batch size for inference because we are stacking 3 slices per patient\n",
    "val_loader = DataLoader(val_dataset, batch_size=8, shuffle=False, num_workers=2) \n",
    "test_loader = DataLoader(test_dataset, batch_size=8, shuffle=False, num_workers=2)\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "# Baseline #v6 Architecture - Highly tuned for this dataset\n",
    "model = models.resnet18(weights=None)\n",
    "checkpoint_path = '/kaggle/input/notebooks/ramazanturann/resnet18/best_resnet18_model.pt'\n",
    "\n",
    "if os.path.exists(checkpoint_path):\n",
    "    print(f\"Loading highly optimized baseline weights: {checkpoint_path}\")\n",
    "    state_dict = torch.load(checkpoint_path, weights_only=False)\n",
    "    if 'fc.weight' in state_dict and state_dict['fc.weight'].shape[0] != 12:\n",
    "        del state_dict['fc.weight']\n",
    "        if 'fc.bias' in state_dict:\n",
    "            del state_dict['fc.bias']\n",
    "    model.load_state_dict(state_dict, strict=False)\n",
    "\n",
    "model.fc = nn.Linear(model.fc.in_features, 12)\n",
    "model = model.to(device)\n",
    "\n",
    "criterion = nn.BCEWithLogitsLoss()\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-2)\n",
    "\n",
    "num_epochs = 5 # Reduced epochs to prevent overfitting on the small dataset\n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    train_loss = 0.0\n",
    "    for imgs, targets in tqdm(train_loader, desc=f\"Epoch {epoch+1}/{num_epochs} [Train]\"):\n",
    "        imgs, targets = imgs.to(device), targets.to(device)\n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(imgs)\n",
    "        loss = criterion(outputs, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        train_loss += loss.item() * imgs.size(0)\n",
    "    \n",
    "    train_loss /= len(train_dataset)\n",
    "    \n",
    "    model.eval()\n",
    "    val_loss = 0.0\n",
    "    with torch.no_grad():\n",
    "        for imgs, targets in tqdm(val_loader, desc=f\"Epoch {epoch+1}/{num_epochs} [Val]\"):\n",
    "            B, N, C, H, W = imgs.shape\n",
    "            imgs = imgs.view(B*N, C, H, W).to(device)\n",
    "            targets = targets.to(device)\n",
    "            \n",
    "            # Test-Time Augmentation (TTA)\n",
    "            logits1 = model(imgs)\n",
    "            imgs_flipped = torch.flip(imgs, dims=[3])\n",
    "            logits2 = model(imgs_flipped)\n",
    "            \n",
    "            # Average the TTA predictions\n",
    "            outputs = (logits1 + logits2) / 2.0\n",
    "            \n",
    "            # Slice Ensemble Average (average across the N=3 slices)\n",
    "            outputs = outputs.view(B, N, 12).mean(dim=1)\n",
    "            \n",
    "            loss = criterion(outputs, targets)\n",
    "            val_loss += loss.item() * B\n",
    "            \n",
    "    val_loss /= len(val_dataset)\n",
    "    print(f\"Epoch {epoch+1:02d}/{num_epochs:02d} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f}\")\n",
    "\n",
    "model.eval()\n",
    "predictions = []\n",
    "study_ids = []\n",
    "with torch.no_grad():\n",
    "    for imgs, s_ids in tqdm(test_loader, desc=\"Inference (Slice Ensemble + TTA)\"):\n",
    "        B, N, C, H, W = imgs.shape\n",
    "        imgs = imgs.view(B*N, C, H, W).to(device)\n",
    "        \n",
    "        # Test-Time Augmentation (TTA)\n",
    "        logits1 = model(imgs)\n",
    "        imgs_flipped = torch.flip(imgs, dims=[3])\n",
    "        logits2 = model(imgs_flipped)\n",
    "        \n",
    "        # Average the TTA predictions\n",
    "        outputs = (logits1 + logits2) / 2.0\n",
    "        outputs = torch.sigmoid(outputs)\n",
    "        \n",
    "        # Slice Ensemble Average\n",
    "        outputs = outputs.view(B, N, 12).mean(dim=1)\n",
    "        \n",
    "        predictions.extend(outputs.cpu().numpy())\n",
    "        study_ids.extend(s_ids)\n",
    "\n",
    "sub_df = pd.DataFrame(predictions, columns=labels)\n",
    "sub_df.insert(0, 'StudyInstanceUID', study_ids)\n",
    "sub_df.to_csv('submission.csv', index=False)"
   ]
  }
