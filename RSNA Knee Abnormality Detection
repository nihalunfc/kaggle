   "source": [
    "#v15\n",
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import pydicom\n",
    "import cv2\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision.transforms as transforms\n",
    "import torchvision.models as models\n",
    "from tqdm import tqdm\n",
    "from PIL import Image\n",
    "\n",
    "train_df = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/train.csv')\n",
    "train_series = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series.csv')\n",
    "test_df = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/test.csv')\n",
    "test_series = pd.read_csv('/kaggle/input/competitions/rsna-knee-abnormality-detection/test_series.csv')\n",
    "\n",
    "labels = ['ACL', 'MCL', 'Medial Meniscus', 'Lateral Meniscus', 'Medial OA', 'Lateral OA', 'PF OA', 'Effusion', 'Synovitis', \"Baker's\", 'Contusion', 'Fracture']\n",
    "\n",
    "# --- TOP-TIER NLP: Negation-Aware Pseudo-Labeling ---\n",
    "def extract_label(report, keywords):\n",
    "    sentences = report.split('.')\n",
    "    negations = ['no ', 'without', 'unremarkable', 'normal', 'intact', 'negative', 'absent', 'clear', 'not ']\n",
    "    \n",
    "    for sentence in sentences:\n",
    "        sentence = sentence.strip()\n",
    "        if any(kw in sentence for kw in keywords):\n",
    "            # If a negation word is in the same sentence as the keyword, it's a false positive!\n",
    "            if any(neg in sentence for neg in negations):\n",
    "                return 0.0 \n",
    "            else:\n",
    "                return 1.0 \n",
    "    return 0.0\n",
    "\n",
    "def pseudo_label_reports_smarter(df):\n",
    "    report_col = None\n",
    "    for col in ['Report', 'report', 'report_text', 'text']:\n",
    "        if col in df.columns:\n",
    "            report_col = col\n",
    "            break\n",
    "            \n",
    "    if report_col is None:\n",
    "        print(\"Warning: Report column not found. Assuming 0.0\")\n",
    "        df[labels] = df[labels].fillna(0.0)\n",
    "        return df\n",
    "        \n",
    "    print(f\"Generating Negation-Aware pseudo-labels from '{report_col}'...\")\n",
    "    for idx, row in tqdm(df.iterrows(), total=len(df), desc=\"NLP Pseudo-Labeling\"):\n",
    "        if pd.isna(row['ACL']): \n",
    "            report = str(row[report_col]).lower()\n",
    "            df.at[idx, 'ACL'] = extract_label(report, ['acl tear', 'acl sprain', 'acl rupture', 'anterior cruciate ligament tear'])\n",
    "            df.at[idx, 'MCL'] = extract_label(report, ['mcl tear', 'mcl sprain', 'medial collateral ligament tear'])\n",
    "            df.at[idx, 'Medial Meniscus'] = extract_label(report, ['medial meniscus tear'])\n",
    "            df.at[idx, 'Lateral Meniscus'] = extract_label(report, ['lateral meniscus tear'])\n",
    "            df.at[idx, 'Medial OA'] = extract_label(report, ['medial compartment osteoarthritis', 'medial joint space narrowing', 'medial oa'])\n",
    "            df.at[idx, 'Lateral OA'] = extract_label(report, ['lateral compartment osteoarthritis', 'lateral joint space narrowing', 'lateral oa'])\n",
    "            df.at[idx, 'PF OA'] = extract_label(report, ['patellofemoral osteoarthritis', 'patellofemoral narrowing', 'pf oa'])\n",
    "            df.at[idx, 'Effusion'] = extract_label(report, ['effusion'])\n",
    "            df.at[idx, 'Synovitis'] = extract_label(report, ['synovitis'])\n",
    "            df.at[idx, \"Baker's\"] = extract_label(report, ['baker', 'popliteal cyst'])\n",
    "            df.at[idx, 'Contusion'] = extract_label(report, ['contusion', 'bone bruise'])\n",
    "            df.at[idx, 'Fracture'] = extract_label(report, ['fracture', ' fx '])\n",
    "    return df\n",
    "\n",
    "train_df = pseudo_label_reports_smarter(train_df)\n",
    "# -----------------------------------------------------------------------------\n",
    "\n",
    "class KneeDatasetCNNRNN(Dataset):\n",
    "    def __init__(self, df, series_df, data_dir, transform=None, num_slices=10, is_inference=False):\n",
    "        self.df = df\n",
    "        self.series_df = series_df\n",
    "        self.data_dir = data_dir\n",
    "        self.transform = transform\n",
    "        self.num_slices = num_slices\n",
    "        self.is_inference = is_inference\n",
    "        self.studies = self.df['StudyInstanceUID'].values\n",
    "        \n",
    "    def __len__(self):\n",
    "        return len(self.studies)\n",
    "        \n",
    "    def _process_dcm(self, dcm):\n",
    "        img = dcm.pixel_array\n",
    "        img = img - np.min(img)\n",
    "        if np.max(img) > 0:\n",
    "            img = img / np.max(img)\n",
    "        img = (img * 255).astype(np.uint8)\n",
    "        img = cv2.resize(img, (224, 224))\n",
    "        img = np.stack([img]*3, axis=-1)\n",
    "        return Image.fromarray(img)\n",
    "        \n",
    "    def __getitem__(self, idx):\n",
    "        study_id = self.studies[idx]\n",
    "        study_series = self.series_df[self.series_df['StudyInstanceUID'] == study_id]\n",
    "        \n",
    "        if len(study_series) > 0:\n",
    "            series_id = study_series.iloc[0]['SeriesInstanceUID']\n",
    "            series_dir = os.path.join(self.data_dir, study_id, series_id)\n",
    "            try:\n",
    "                slices = [f for f in os.listdir(series_dir) if f.endswith('.dcm')]\n",
    "                slices.sort()\n",
    "                l = len(slices)\n",
    "                \n",
    "                # Uniformly extract `num_slices` ignoring the very edges (top 10% and bottom 10%)\n",
    "                indices = np.linspace(max(0, int(l*0.1)), min(l-1, int(l*0.9)), self.num_slices, dtype=int)\n",
    "                \n",
    "                # Training Jitter: slight random shift to prevent memorization\n",
    "                if not self.is_inference:\n",
    "                    jitter = np.random.randint(-1, 2, size=self.num_slices)\n",
    "                    indices = np.clip(indices + jitter, 0, l-1)\n",
    "                    \n",
    "                imgs = []\n",
    "                for s_idx in indices:\n",
    "                    dcm = pydicom.dcmread(os.path.join(series_dir, slices[s_idx]))\n",
    "                    img = self._process_dcm(dcm)\n",
    "                    if self.transform: img = self.transform(img)\n",
    "                    imgs.append(img)\n",
    "                img_tensor = torch.stack(imgs)\n",
    "            except:\n",
    "                blank = Image.fromarray(np.zeros((224, 224, 3), dtype=np.uint8))\n",
    "                img_tensor = torch.stack([self.transform(blank) if self.transform else transforms.ToTensor()(blank) for _ in range(self.num_slices)])\n",
    "        else:\n",
    "            blank = Image.fromarray(np.zeros((224, 224, 3), dtype=np.uint8))\n",
    "            img_tensor = torch.stack([self.transform(blank) if self.transform else transforms.ToTensor()(blank) for _ in range(self.num_slices)])\n",
    "            \n",
    "        if all(col in self.df.columns for col in labels):\n",
    "            target = self.df.loc[idx, labels].values.astype(np.float32)\n",
    "            return img_tensor, torch.tensor(target)\n",
    "        else:\n",
    "            return img_tensor, study_id\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.RandomRotation(15),\n",
    "    transforms.ColorJitter(brightness=0.2, contrast=0.2),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "test_transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "train_dataset = KneeDatasetCNNRNN(train_df.iloc[:int(len(train_df)*0.8)].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=train_transform, is_inference=False)\n",
    "val_dataset = KneeDatasetCNNRNN(train_df.iloc[int(len(train_df)*0.8):].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=test_transform, is_inference=True)\n",
    "test_dataset = KneeDatasetCNNRNN(test_df, test_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/test_series', transform=test_transform, is_inference=True)\n",
    "\n",
    "# Batch size 8 is extremely safe for a CNN-RNN (8 patients * 10 slices = 80 images per forward pass)\n",
    "train_loader = DataLoader(train_dataset, batch_size=8, shuffle=True, num_workers=4)\n",
    "val_loader = DataLoader(val_dataset, batch_size=8, shuffle=False, num_workers=4) \n",
    "test_loader = DataLoader(test_dataset, batch_size=8, shuffle=False, num_workers=4)\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "# --- TOP-TIER ARCHITECTURE: 3D CNN-RNN ---\n",
    "class KneeCNNRNN(nn.Module):\n",
    "    def __init__(self, num_classes=12, hidden_dim=256):\n",
    "        super().__init__()\n",
    "        self.backbone = models.resnet18(weights=None)\n",
    "        \n",
    "        checkpoint_path = '/kaggle/input/notebooks/ramazanturann/resnet18/best_resnet18_model.pt'\n",
    "        if os.path.exists(checkpoint_path):\n",
    "            print(f\"Loading highly optimized ResNet backbone: {checkpoint_path}\")\n",
    "            state_dict = torch.load(checkpoint_path, weights_only=False)\n",
    "            if 'fc.weight' in state_dict: del state_dict['fc.weight']\n",
    "            if 'fc.bias' in state_dict: del state_dict['fc.bias']\n",
    "            self.backbone.load_state_dict(state_dict, strict=False)\n",
    "            \n",
    "        # Bypass the FC layer to get raw 512-dim feature vectors\n",
    "        self.backbone.fc = nn.Identity()\n",
    "        \n",
    "        # LSTM processes the sequence of slices to understand 3D relationships\n",
    "        self.lstm = nn.LSTM(input_size=512, hidden_size=hidden_dim, num_layers=1, batch_first=True, bidirectional=True)\n",
    "        self.fc = nn.Linear(hidden_dim * 2, num_classes)\n",
    "        \n",
    "    def forward(self, x):\n",
    "        # x shape: [B, S, C, H, W]\n",
    "        B, S, C, H, W = x.shape\n",
    "        x = x.view(B * S, C, H, W)\n",
    "        \n",
    "        features = self.backbone(x) # [B*S, 512]\n",
    "        features = features.view(B, S, 512)\n",
    "        \n",
    "        lstm_out, _ = self.lstm(features) # [B, S, 512] (hidden_dim=256, bidirectional=True -> 256*2)\n",
    "        \n",
    "        # Average the LSTM outputs across all sequence slices\n",
    "        pooled = torch.mean(lstm_out, dim=1)\n",
    "        \n",
    "        logits = self.fc(pooled)\n",
    "        return logits\n",
    "\n",
    "model = KneeCNNRNN(num_classes=12).to(device)\n",
    "\n",
    "criterion = nn.BCEWithLogitsLoss()\n",
    "# Smaller learning rate for the pretrained backbone, higher for the new LSTM head\n",
    "optimizer = torch.optim.AdamW([\n",
    "    {'params': model.backbone.parameters(), 'lr': 1e-5},\n",
    "    {'params': model.lstm.parameters(), 'lr': 1e-4},\n",
    "    {'params': model.fc.parameters(), 'lr': 1e-4}\n",
    "], weight_decay=1e-2)\n",
    "\n",
    "num_epochs = 5 \n",
    "for epoch in range(num_epochs):\n",
    "    model.train()\n",
    "    train_loss = 0.0\n",
    "    for imgs, targets in tqdm(train_loader, desc=f\"Epoch {epoch+1}/{num_epochs} [Train]\"):\n",
    "        imgs, targets = imgs.to(device), targets.to(device)\n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(imgs)\n",
    "        loss = criterion(outputs, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        train_loss += loss.item() * imgs.size(0)\n",
    "    \n",
    "    train_loss /= len(train_dataset)\n",
    "    \n",
    "    model.eval()\n",
    "    val_loss = 0.0\n",
    "    with torch.no_grad():\n",
    "        for imgs, targets in tqdm(val_loader, desc=f\"Epoch {epoch+1}/{num_epochs} [Val]\"):\n",
    "            imgs, targets = imgs.to(device), targets.to(device)\n",
    "            \n",
    "            # TTA for CNN-RNN (flip along width dimension: dim 4)\n",
    "            logits1 = model(imgs)\n",
    "            imgs_flipped = torch.flip(imgs, dims=[4])\n",
    "            logits2 = model(imgs_flipped)\n",
    "            \n",
    "            outputs = (logits1 + logits2) / 2.0\n",
    "            \n",
    "            loss = criterion(outputs, targets)\n",
    "            val_loss += loss.item() * imgs.size(0)\n",
    "            \n",
    "    val_loss /= len(val_dataset)\n",
    "    print(f\"Epoch {epoch+1:02d}/{num_epochs:02d} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f}\")\n",
    "\n",
    "model.eval()\n",
    "predictions = []\n",
    "study_ids = []\n",
    "with torch.no_grad():\n",
    "    for imgs, s_ids in tqdm(test_loader, desc=\"Inference (CNN-RNN + TTA)\"):\n",
    "        imgs = imgs.to(device)\n",
    "        \n",
    "        logits1 = model(imgs)\n",
    "        imgs_flipped = torch.flip(imgs, dims=[4])\n",
    "        logits2 = model(imgs_flipped)\n",
    "        \n",
    "        outputs = (logits1 + logits2) / 2.0\n",
    "        outputs = torch.sigmoid(outputs)\n",
    "        \n",
    "        predictions.extend(outputs.cpu().numpy())\n",
    "        study_ids.extend(s_ids)\n",
    "\n",
    "sub_df = pd.DataFrame(predictions, columns=labels)\n",
    "sub_df.insert(0, 'StudyInstanceUID', study_ids)\n",
    "sub_df.to_csv('submission.csv', index=False)"
   ]
  }
