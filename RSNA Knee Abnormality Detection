s_df[self.series_df['StudyInstanceUID'] == study_id]\n        \n        if len(study_series) > 0:\n            series_id = study_series.iloc[0]['SeriesInstanceUID']\n            series_dir = os.path.join(self.data_dir, study_id, series_id)\n            try:\n                slices = [f for f in os.listdir(series_dir) if f.endswith('.dcm')]\n                slices.sort()\n                mid_slice = slices[len(slices)//2]\n                dcm = pydicom.dcmread(os.path.join(series_dir, mid_slice))\n                img = dcm.pixel_array\n                img = img - np.min(img)\n                if np.max(img) > 0:\n                    img = img / np.max(img)\n                img = (img * 255).astype(np.uint8)\n                img = cv2.resize(img, (224, 224))\n                img = np.stack([img]*3, axis=-1)\n            except:\n                img = np.zeros((224, 224, 3), dtype=np.uint8)\n        else:\n            img = np.zeros((224, 224, 3), dtype=np.uint8)\n            \n        if self.transform:\n            img = self.transform(img)\n            \n        if all(col in self.df.columns for col in labels):\n            target = self.df.loc[idx, labels].values.astype(np.float32)\n            return img, torch.tensor(target)\n        else:\n            return img, study_id\n\ntransform = transforms.Compose([\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\ntrain_dataset = KneeDataset(train_df.iloc[:int(len(train_df)*0.8)].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=transform)\nval_dataset = KneeDataset(train_df.iloc[int(len(train_df)*0.8):].reset_index(drop=True), train_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/train_series', transform=transform)\ntest_dataset = KneeDataset(test_df, test_series, '/kaggle/input/competitions/rsna-knee-abnormality-detection/test_series', transform=transform)\n\ntrain_loader = DataLoader(train_dataset, batch_size=16, shuffle=True, num_workers=2)\nval_loader = DataLoader(val_dataset, batch_size=16, shuffle=False, num_workers=2)\ntest_loader = DataLoader(test_dataset, batch_size=16, shuffle=False, num_workers=2)\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nmodel = models.resnet18(weights=None)\ncheckpoint = torch.load('/kaggle/input/notebooks/ramazanturann/resnet18/best_resnet18_model.pt', weights_only=False)\nstate_dict = checkpoint['model_state_dict']\n\nif 'fc.weight' in state_dict and state_dict['fc.weight'].shape[0] != 12:\n    del state_dict['fc.weight']\n    if 'fc.bias' in state_dict:\n        del state_dict['fc.bias']\n\nmodel.fc = nn.Linear(model.fc.in_features, 12)\nmodel.load_state_dict(state_dict, strict=False)\nmodel = model.to(device)\n\ncriterion = nn.BCEWithLogitsLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n\nfor epoch in range(1):\n    model.train()\n    for imgs, targets in tqdm(train_loader):\n        imgs, targets = imgs.to(device), targets.to(device)\n        optimizer.zero_grad()\n        outputs = model(imgs)\n        loss = criterion(outputs, targets)\n        loss.backward()\n        optimizer.step()\n\nmodel.eval()\npredictions = []\nstudy_ids = []\nwith torch.no_grad():\n    for imgs, s_ids in tqdm(test_loader):\n        imgs = imgs.to(device)\n        outputs = torch.sigmoid(model(imgs))\n        predictions.extend(outputs.cpu().numpy())\n        study_ids.extend(s_ids)\n\nsub_df = pd.DataFrame(predictions, columns=labels)\nsub_df.insert(0, 'StudyInstanceUID', study_ids)\nsub_df.to_csv('submission.csv', index=False)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:42:48.439615Z","iopub.execute_input":"2026-08-08T07:42:48.440042Z","iopub.status.idle":"2026-08-08T07:42:52.692344Z","shell.execute_reply.started":"2026-08-08T07